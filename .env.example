# Copy to .env for local development, or set these in Render's dashboard.
# .env is gitignored - never commit real values.

# Port the proxy listens on. Render injects this automatically.
PORT=3002

# REQUIRED. The webhook that receives uploaded claim documents.
# The server will refuse to start without it. Treat it as a credential:
# anyone who has it can trigger the workflow.
N8N_WEBHOOK_URL=https://your-backend.example.com/api/webhook/your-webhook-id

# Hosts the proxy is allowed to forward to, comma-separated.
# Defaults to the host of N8N_WEBHOOK_URL.
#
# IMPORTANT: the backend hands resume URLs back to the browser, and those get
# forwarded through /resume. If resume URLs come back on a different host than
# the upload webhook, list every host here or the claim will fail at the
# "Proceed to Claim Summary" step with "Requested resume host is not allowed".
#   ALLOWED_WEBHOOK_HOSTS=api.example.com,n8n.example.com
ALLOWED_WEBHOOK_HOSTS=your-backend.example.com

# Browser origins allowed to call the proxy cross-origin.
# Leave as * for a same-origin Render deployment (interface and proxy on one host).
ALLOWED_ORIGINS=*

# Upload limits enforced server-side, in bytes / count.
MAX_FILE_SIZE=52428800
MAX_FILES=5
